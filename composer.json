{
    "name": "micrositios/pqrdeadline",
    "description": "Librería PHP para calcular plazos de solicitudes PQR",
    "type": "library",
    "keywords": [
        "pqr",
        "pqrs",
        "deadlines",
        "colombia",
        "business-days"
    ],
    "homepage": "https://github.com/micros/pqrdeadline",
    "license": "MIT",
    "version": "2.0.0",
    "authors": [
        {
            "name": "Leonardo Forero Sandoval"
        }
    ],
    "support": {
        "issues": "https://github.com/micros/pqrdeadline/issues",
        "source": "https://github.com/micros/pqrdeadline"
    },
    "require": {
        "php": "^8.4",
        "ext-calendar": "*",
        "cmixin/business-day": "^1.21",
        "nesbot/carbon": "^3.14.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5.55"
    },
    "autoload": {
        "psr-4": {
            "Micrositios\\PqrDeadline\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Micrositios\\PqrDeadline\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "@php vendor/bin/phpunit --do-not-cache-result"
    },
    "archive": {
        "exclude": [
            "/.github",
            "/vendor",
            "/composer.lock",
            "/.phpunit.cache",
            "/coverage",
            "/build",
            "/dist",
            "/.idea",
            "/.vscode",
            ".DS_Store",
            "*.log"
        ]
    },
    "config": {
        "sort-packages": true,
        "platform": {
            "php": "8.4.0"
        }
    }
}